<header class="tm-topbar" id="tmTopbar">
  <div class="tm-shell tm-topbar__inner">
    <a href="/" class="tm-brand" aria-label="Trust.med home">
      <svg
        class="tm-logo-mark"
        viewBox="0 0 220 40"
        xmlns="http://www.w3.org/2000/svg"
        role="img"
        aria-label="Trust.med"
      >
        <text
          x="0"
          y="28"
          font-family="Inter, Arial, Helvetica, sans-serif"
          font-size="26"
          font-weight="800"
          letter-spacing="-0.04em"
          fill="#111111"
        >
          Trust<tspan fill="#E4572E">.</tspan>med
        </text>
      </svg>
    </a>

    <button
      class="tm-menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="tmMobileNav"
      aria-label="Open menu"
    >
      <span class="tm-menu-toggle__line"></span>
      <span class="tm-menu-toggle__line"></span>
      <span class="tm-menu-toggle__line"></span>
    </button>

    <nav class="tm-nav" id="tmMobileNav" aria-label="Primary">
      <a href="/" class="tm-nav__link tm-nav__link--section{% if navKey == 'network' %} is-active-section{% endif %}">Network</a>
      <a href="/atlas/" class="tm-nav__link tm-nav__link--section{% if navKey == 'atlas' %} is-active-section{% endif %}">Atlas</a>
      <a href="/pricing/" class="tm-nav__link tm-nav__link--section{% if navKey == 'pricing' %} is-active-section{% endif %}">Pricing</a>
      <a href="/blog/" class="tm-nav__link tm-nav__link--section{% if navKey == 'blog' %} is-active-section{% endif %}">Insights</a>
      <a href="/map/" class="tm-nav__link tm-nav__link--map"{% if navKey == 'map' %} aria-current="page"{% endif %}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 5 6-2 6 2 6-2v16l-6 2-6-2-6 2Z M9 3v16 M15 5v16"/><path d="m6 10 3 2 6-3 3 2" stroke-dasharray="1 3"/></svg>
        <span>Pharmatech Map</span>
      </a>

      <a
        href="https://dashboard.trust.med"
        class="tm-nav__link tm-nav__link--signin-mobile"
        aria-label="Sign in to dashboard"
        title="Sign in to Trust.med dashboard"
      >
        <svg class="tm-signin__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
          <path stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
          <path stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            d="M10 17l5-5-5-5"/>
          <path stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            d="M15 12H3"/>
        </svg>
        <span>Sign In</span>
      </a>
    </nav>

    <div class="tm-topbar__actions">
      <a
        href="https://dashboard.trust.med"
        class="tm-signin"
        aria-label="Sign in to dashboard"
        title="Sign in to Trust.med dashboard"
      >
        <svg class="tm-signin__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
          <path stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            d="M10 17l5-5-5-5"/>
          <path stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            d="M15 12H3"/>
        </svg>
      </a>
    </div>
  </div>
</header>
